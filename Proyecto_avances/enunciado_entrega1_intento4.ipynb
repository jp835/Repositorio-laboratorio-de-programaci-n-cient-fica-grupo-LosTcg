    "#Transformaciones para calcular porcentaje de compra semanal de cada subcategoria, respecto a su categoria\n",
    "\n",
    "from sklearn.base import BaseEstimator, TransformerMixin\n",
    "import numpy as np\n",
    "\n",
    "class Porcentaje_subcategoria(BaseEstimator, TransformerMixin):\n",
    "    def __init__(self, group_cols=None, value_col='items'):\n",
    "        self.group_cols = group_cols or ['customer_id', 'semana']\n",
    "        self.value_col = value_col\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        return self  # No necesita ajustar nada\n",
    "\n",
    "    def transform(self, X):\n",
    "        df = X.copy()\n",
    "\n",
    "        # Paso 1: sumar items por cliente, semana y sub_category\n",
    "        subcat_sum = df.groupby(self.group_cols + ['sub_category'])[self.value_col].sum().reset_index()\n",
    "        subcat_sum.rename(columns={self.value_col: 'items_subcat'}, inplace=True)\n",
    "\n",
    "        # Paso 2: sumar total de items por cliente y semana\n",
    "        total_sum = df.groupby(self.group_cols)[self.value_col].sum().reset_index()\n",
    "        total_sum.rename(columns={self.value_col: 'items_totales'}, inplace=True)\n",
    "\n",
    "        # Paso 3: merge para unir info de subcat y total\n",
    "        merged = pd.merge(subcat_sum, total_sum, on=self.group_cols)\n",
    "\n",
    "        # ⚠️ Paso 3.5: evitar división por cero\n",
    "        merged['pct_items_subcat'] = np.where(\n",
    "            merged['items_totales'] == 0,\n",
    "            0,\n",
    "            merged['items_subcat'] / merged['items_totales']\n",
    "        )\n",
    "\n",
    "        # Paso 4: merge de vuelta al df original\n",
    "        df = pd.merge(\n",
    "            df,\n",
    "            merged[self.group_cols + ['sub_category', 'pct_items_subcat']],\n",
    "            on=self.group_cols + ['sub_category'],\n",
    "            how='left'\n",
    "        )\n",
    "\n",
    "        # ⚠️ Paso 5: reemplazar NaN con 0 si no hubo compras en esa subcategoría\n",
    "        df['pct_items_subcat'] = df['pct_items_subcat'].fillna(0)\n",
    "\n",
    "        return df\n"
   ]
