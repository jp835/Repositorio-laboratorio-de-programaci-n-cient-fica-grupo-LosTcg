    "subcat_sum = (\n",
    "    df_final\n",
    "    .groupby(['customer_id', 'semana', 'sub_category'])['items']\n",
    "    .sum()\n",
    "    .reset_index()\n",
    "    .rename(columns={'items': 'items_subcat'})\n",
