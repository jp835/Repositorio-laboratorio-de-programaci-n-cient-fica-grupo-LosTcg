    "import pandas as pd\n",
    "from sklearn.base import BaseEstimator, TransformerMixin\n",
    "\n",
    "class PromedioItemsProductoPorSemana(BaseEstimator, TransformerMixin):\n",
    "    def __init__(self, col_producto='product_id', col_semana='semana', col_items='items'):\n",
    "        self.col_producto = col_producto\n",
    "        self.col_semana = col_semana\n",
    "        self.col_items = col_items\n",
    "        self.promedios_ = None\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        df = X.copy()\n",
    "\n",
    "        # 🔹 Calcular promedio de items por producto y semana (del año)\n",
    "        self.promedios_ = (\n",
    "            df.groupby([self.col_producto, self.col_semana])[self.col_items]\n",
    "            .mean()\n",
    "            .reset_index(name='promedio_items_producto_en_semana')\n",
    "        )\n",
    "\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        df = X.copy()\n",
    "\n",
    "        # 🔹 Merge con el dataframe original\n",
    "        df = df.merge(\n",
    "            self.promedios_,\n",
    "            on=[self.col_producto, self.col_semana],\n",
    "            how='left'\n",
    "        )\n",
    "\n",
    "        # 🔹 Rellenar posibles faltantes con 0 (producto no comprado esa semana)\n",
    "        df['promedio_items_producto_en_semana'] = df['promedio_items_producto_en_semana'].fillna(0)\n",
    "\n",
