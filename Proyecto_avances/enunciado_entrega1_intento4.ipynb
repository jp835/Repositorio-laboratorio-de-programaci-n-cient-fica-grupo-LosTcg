>>>>>>> bd0125f538d37a6968b91957e4cf884fa7d2e0ff
   "metadata": {},
   "outputs": [],
   "source": [
    "#Se genera el pipeline de pre-procesamiento \n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "\n",
    "\n",
    "# numeric_features = [\"num_deliver_per_week\", \"num_visit_per_week\", \"size\", \"semana\", \"año\"]\n",
    "# categorical_features = [\"customer_type\", \"brand\", \"category\", \"sub_category\", \"segment\", \"package\"]\n",
    "\n",
    "\n",
    "\n",
    "numeric_pipeline = Pipeline(steps=[\n",
    "    (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "    (\"outlier\", IQR(cols=numeric_features, lbda=1.5)),\n",
    "    (\"pass_names\", PassFeatureNames()),\n",
    "    (\"scaler\", MinMaxScaler())\n",
    "])\n",
    "\n",
    "categorical_pipeline = Pipeline(steps=[\n",
    "    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "    (\"encoder\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))\n",
    "])\n",
    "\n",
    "\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\"num\", numeric_pipeline, numeric_features),\n",
    "        (\"cat\", categorical_pipeline, categorical_features),\n",
    "\n",
    "    ],\n",
    "    remainder=\"drop\"\n",
    ")\n",
    "\n"
   ]
  },
