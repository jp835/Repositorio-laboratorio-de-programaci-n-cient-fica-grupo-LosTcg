    "\n",
    "# Paso 2: sumar total de items por cliente y semana\n",
    "total_sum = (\n",
    "    df_final\n",
    "    .groupby(['customer_id', 'semana'])['items']\n",
    "    .sum()\n",
    "    .reset_index()\n",
    "    .rename(columns={'items': 'items_totales'})\n",
    ")\n",
    "\n",
    "# Paso 3: merge para unir info de subcat y total\n",
    "merged = pd.merge(subcat_sum, total_sum, on=['customer_id', 'semana'])\n",
    "\n",
    "# Paso 3.5: evitar división por cero y calcular porcentaje\n",
    "merged['pct_items_subcat'] = np.where(\n",
    "    merged['items_totales'] == 0,\n",
    "    0,\n",
    "    merged['items_subcat'] / merged['items_totales']\n",
    ")\n",
    "\n",
    "merged"
   ]
