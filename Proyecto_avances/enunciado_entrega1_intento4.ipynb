   "source": [
    "df_transacciones[\"purchase_date\"] = pd.to_datetime(df_transacciones[\"purchase_date\"])\n",
    "df_transacciones[\"week\"] = df_transacciones[\"purchase_date\"].dt.strftime('%Y-%U')\n",
    "\n",
    "\n",
    "# Filtrar clientes y productos con compras\n",
    "clientes_activos = df_transacciones[\"customer_id\"].unique()\n",
    "productos_comprados = df_transacciones[\"product_id\"].unique()\n",
    "semanas_activas = df_transacciones[\"week\"].unique()\n",
    "\n",
    "clientes_df = pd.DataFrame({\"customer_id\": clientes_activos})\n",
    "productos_df = pd.DataFrame({\"product_id\": productos_comprados})\n",
    "semanas_df = pd.DataFrame({\"week\": semanas_activas})\n",
    "\n",
    "# Clientes x Productos\n",
    "cliente_producto = clientes_df.merge(productos_df, how='cross')\n",
    "\n",
    "# Cliente-Producto x Semana\n",
    "cliente_producto_semana = cliente_producto.merge(semanas_df, how='cross')\n",
    "\n",
    "#compras = (\n",
    "#    df_transacciones\n",
    "#    .groupby(['customer_id', 'product_id', 'week'])\n",
    "#    .size()\n",
    "#    .reset_index(name='compró')\n",
    "#)\n",
    "\n",
    "#compras['compró'] = 1\n",
    "\n",
    "compras = (\n",
    "    df_transacciones\n",
    "    .groupby(['customer_id', 'product_id', 'week'])\n",
    "    .agg(\n",
    "        compró=('order_id', 'count'),  # o cualquier otra forma de definir compra\n",
    "        items=('items', 'sum')         # suma de unidades compradas esa semana\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# Convertir \"compró\" en binario si querés:\n",
    "compras['compró'] = (compras['compró'] > 0).astype(int)\n",
    "\n",
    "df_final = cliente_producto_semana.merge(\n",
    "    compras,\n",
    "    on=['customer_id', 'product_id', 'week'],\n",
    "    how='left'\n",
    ")\n",
    "\n",
    "# Llenar los nulos con 0 (no hubo compra)\n",
    "df_final['compró'] = df_final['compró'].fillna(0).astype(int)\n",
    "df_final['items'] = df_final['items'].fillna(0).astype(float)\n",
    "df_final[['año', 'semana']] = df_final['week'].str.split('-', expand=True)\n",
    "df_final['año'] = df_final['año'].astype(int)\n",
    "df_final['semana'] = df_final['semana'].astype(int)\n",
    "\n",
    "df_final"
   ]
  },
