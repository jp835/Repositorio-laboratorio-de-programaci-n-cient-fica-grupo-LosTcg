    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.metrics import classification_report\n",
    "from lightgbm import LGBMClassifier\n",
    "\n",
    "# ============================================\n",
    "# 🔹 Cálculo del balance de clases\n",
    "# ============================================\n",
    "neg, pos = y_train.value_counts()\n",
    "scale = neg / pos\n",
    "print(f\"scale_pos_weight (clase minoritaria): {scale:.2f}\")\n",
    "\n",
    "# ============================================\n",
    "# 🔹 Configuración del modelo LightGBM (GPU)\n",
    "# ============================================\n",
    "lgb_gpu = LGBMClassifier(\n",
    "    n_estimators=200,\n",
    "    learning_rate=0.1,\n",
    "    num_leaves=31,\n",
    "    random_state=42,\n",
    "    class_weight={0: 1, 1: scale},  # ⚖️ Pondera clase minoritaria\n",
    "    device=\"gpu\"\n",
    ")\n",
    "\n",
    "# ============================================\n",
    "# 🔹 Creación del pipeline\n",
    "# ============================================\n",
    "lgb_pipeline = Pipeline(steps=[\n",
    "    (\"preprocessing\", preprocessor),\n",
    "    (\"classifier\", lgb_gpu)\n",
    "])\n",
    "\n",
    "# ============================================\n",
    "# 🔹 Entrenamiento del modelo\n",
    "# ============================================\n",
    "print(\"\\n===== LightGBM GPU Weighted =====\")\n",
    "lgb_pipeline.fit(X_train, y_train)\n",
    "\n",
    "# ============================================\n",
    "# 🔹 Evaluación del modelo\n",
    "# ============================================\n",
    "print(\"\\nValidation Report:\")\n",
    "y_val_pred = lgb_pipeline.predict(X_val)\n",
    "print(classification_report(y_val, y_val_pred))\n",
    "\n",
    "print(\"\\nTest Report:\")\n",
    "y_test_pred = lgb_pipeline.predict(X_test)\n",
    "print(classification_report(y_test, y_test_pred))"
   ]
